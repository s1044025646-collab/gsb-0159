{
  "name": "fat16-inspector",
  "version": "1.0.0",
  "description": "Windows-local FAT16 image directory parser and cluster-chain consistency checker (API + CLI + synthetic images + tests)",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-reporter=spec test/*.test.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "cli": "node --experimental-strip-types src/cli/index.ts",
    "serve": "node --experimental-strip-types src/api/server.ts",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.0"
  }
}
